# -*- makefile -*-
# vi:se ft=make:

BITS-$(CONFIG_BIT32) = 32
BITS-$(CONFIG_BIT64) = 64
BITS = $(BITS-y)

# Include for unit tests, enable by including UTEST in SUBSYSTEMS.
include $(srcdir)/test/utest/Modules.utest
#
# CXXLIB Subsystem
# 
CXXLIB 			:= libcxx.a
VPATH			+= lib/cxxlib
CXXSRC_CXXLIB 		+= paranoia.cc

CXXSRC_ABI += kip.cc

CXXSRC_ABI-$(CONFIG_JDB) += \
	l4_types_dbg.cc l4_error_dbg.cc kip_dbg.cc

CXXSRC_ABI += $(CXXSRC_ABI-y)

CXXSRC_KERNEL += \
	cpu_generic.cc \
	banner.cc \
	pfc.cc \
	boot_alloc.cc \
	config.cc \
	config_arch.cc \
	context.cc \
	context_drq.cc \
	cpu_call.cc \
	cpu_lock.cc \
	factory.cc \
	globals.cc \
	helping_lock.cc \
	ipc_gate.cc \
	ipc_timeout.cc \
	irq.cc \
	irq_chip.cc \
	irq_mgr.cc \
	kernel_console.cc \
	kernel_panic.cc \
	kernel_task.cc \
	kernel_thread-std.cc \
	kernel_thread.cc \
	kip_init.cc \
	kmem_alloc.cc \
	kmem_slab.cc \
	kmem.cc \
	kmem_mmio.cc \
	kobject.cc \
	kobject_helper.cc \
	kobject_iface.cc \
	koptions.cc \
	libc_backend_lock.cc \
	mapdb.cc \
	mapping_tree.cc \
	map_util_mem.cc \
	map_util_objs.cc \
	map_util.cc \
	mem_space_base.cc \
	pm.cc \
	platform_control_object.cc \
	ram_quota.cc \
	rcupdate.cc \
	sched.cc \
	sched_context.cc \
	scheduler.cc \
	scheduler_iface.cc \
	semaphore.cc \
	wait_queue.cc \
	slab_cache.cc \
	space.cc \
	syscalls.cc \
	task.cc \
	terminate.cc \
	thread.cc \
	thread_object.cc \
	timeout.cc \
	timeslice_timeout.cc \
	trap_state.cc \
	vlog.cc \

CXXSRC_KERNEL-$(CONFIG_FPU) += fpu_alloc.cc fpu.cc fpu_arch.cc
CXXSRC_KERNEL-$(CONFIG_MP) += per_cpu_data_mp.cc per_cpu_data_alloc.cc \
			      app_cpu_thread.cc ipi.cc \
			      context_mp.cc

CXXSRC_KERNEL-$(CONFIG_SERIAL) += kernel_uart.cc
ifeq ($(CONFIG_SERIAL)$(CONFIG_INPUT),yy)
CXXSRC_KERNEL += vkey_serial.cc
else
CXXSRC_KERNEL += vkey_noserial.cc
endif
CXXSRC_KERNEL-y$(CONFIG_PERF_CNT) += perf_cnt_dummy.cc

CXXFLAGS_kernel_uart = $(LIBUART_UART_FLAGS)

CXXSRC_KERNEL-$(CONFIG_JDB) += \
	syscalls-log.cc \
	dbg_page_info.cc kobject_dbg.cc jdb_object.cc \
	tb_entry_generic.cc \
	drq_log.cc vcpu_log.cc context_dbg.cc exregs_log.cc \
	dbg_stack.cc jdb_trace.cc jdb_coredump.cc

ifneq ($(CONFIG_NDEBUG),y)
CXXSRC_KERNEL-$(CONFIG_JDB)  += assertion-dbg.cc
CXXSRC_KERNEL-y$(CONFIG_JDB) += assertion.cc
endif

CXXFLAGS_K_SCHED_CONTEXT-$(CONFIG_SCHED_FIXED_PRIO) := -DSCHED_CONTEXT_IMPL='"sched_context_fp.h"'
CXXFLAGS_K_SCHED_CONTEXT-$(CONFIG_SCHED_WFQ)        := -DSCHED_CONTEXT_IMPL='"sched_context_wfq.h"'
CXXFLAGS_K_SCHED_CONTEXT-$(CONFIG_SCHED_FP_WFQ)     := -DSCHED_CONTEXT_IMPL='"sched_context_fp_wfq.h"'

CXXFLAGS += $(CXXFLAGS_K_SCHED_CONTEXT-y)

OBJ_SPACE_TYPE = $(if $(CONFIG_VIRT_OBJ_SPACE),virt,phys)

VPATH_JDB += jdb
PRIVATE_INCDIR += jdb/$(CONFIG_NARCH)/$(BITS) jdb/$(CONFIG_XARCH) jdb/$(CONFIG_NARCH) jdb jabi

CXXSRC_JDB += kern_cnt.cc push_console.cc jdb_core.cc jdb_list.cc jdb_timeout.cc \
	      jdb_module.cc jdb_ipc_gate.cc jdb_input.cc jdb_input_task.cc \
	      jdb_kobject.cc jdb_utcb.cc jdb_thread.cc jdb_thread_list.cc \
	      jdb_tbuf_show.cc jdb_tbuf_output.cc jdb_tbuf_init.cc jdb_tbuf.cc \
	      jdb_console_buffer.cc jdb_table.cc jdb_mapdb.cc jdb_prompt_module.cc \
	      jdb_space.cc jdb_obj_space.cc jdb_trap_state.cc jdb_rcupdate.cc \
	      jdb_counters.cc jdb_sender_list.cc jdb_dump.cc jdb_prompt_ext.cc \
	      jdb_attach_irq.cc jdb_screen.cc jdb_factory.cc jdb_kobject_names.cc \
	      jdb_exit_module.cc jdb_report.cc jdb_ptab.cc jdb_ansi.cc \
	      jdb_current_thread.cc jdb.cc jdb_tcb.cc jdb_kern_info.cc \
	      jdb_kern_info_kmem_alloc.cc jdb_kern_info_data.cc jdb_kern_info_kip.cc

CXXSRC_JDB-$(CONFIG_MP) += jdb_cpu_call.cc jdb_ipi.cc
CXXSRC_JDB-$(CONFIG_JDB_DISASM) += jdb_disasm.cc
CXXSRC_KERNEL-$(CONFIG_JDB_GZIP) += jdb_gzip.cc
CXXSRC_JDB-$(CONFIG_JDB_REGEX) += jdb_regex.cc

CXXSRC_JDB += $(CXXSRC_JDB-y) $(CXXSRC_JDB-y-y)

CXXSRC_KERNEL += $(CXXSRC_KERNEL-y)
CXXSRC_KERNEL += $(CXXSRC_KERNEL-y-y)


# - do not profile all of LIBC, because it is used in the BOOT subsystem
# - save some space for debugger, disassembler, ...
NOOPT			+= $(patsubst %.o, %,\
			   $(OBJ_LIBC) $(OBJ_JDB) $(OBJ_LIBDISASM))

# Helper function to generate CXXFLAGS_uart-libuart
LIBUART_UART = -include uart_$(strip $(1)).h \
	       -DFIASCO_UART_TYPE=L4::Uart_$(strip $(if $(2),$(2),$(1)))

ifeq ($(CONFIG_DT),y)
SUBSYSTEMS += LIBFDT
endif

#
# LIBC Subsystem
#
LIBC_ARCH-arm-    := arm
LIBC_ARCH-arm-y   := aarch64
LIBC_ARCH-ia32-   := i386
LIBC_ARCH-amd64-y := x86_64
LIBC_ARCH-mips-   := mips
LIBC_ARCH-mips-y  := mips64
LIBC_ARCH-riscv-  := riscv32
LIBC_ARCH-riscv-y := riscv64
LIBC_ARCH         := $(LIBC_ARCH-$(CONFIG_XARCH)-$(CONFIG_BIT64))
LIBC              := libc.a
VPATH             += lib/libc/glue \
                     lib/libc/src/string \
                     lib/libc/src/ctype \
                     lib/libc/src/errno \
                     lib/libc/src/stdio \
                     lib/libc/src/exit \
                     lib/libc/src/stdlib \
                     lib/libc/src/internal \
                     lib/libc/src/setjmp/$(LIBC_ARCH)
PRIVATE_INCDIR    += lib/libc/arch/$(LIBC_ARCH) \
                     lib/libc/src/internal \
                     lib/libc/src/include \
                     lib/libc/include
CSRC_LIBC         := putchar.c \
                     putstr.c \
                     stdout_write.c \
                     \
                     memchr.c \
                     memmove.c \
                     memset.c \
                     memcmp.c \
                     strlen.c \
                     strnlen.c \
                     strcpy.c \
                     strncpy.c \
                     strcmp.c \
                     stpcpy.c \
                     strchr.c \
                     $(if $(filter ia32,$(CONFIG_XARCH)),,memcpy.c) \
                     strcspn.c \
                     strchrnul.c \
                     stpncpy.c \
                     strrchr.c \
                     memrchr.c \
                     strncmp.c \
                     \
                     strtol.c \
                     \
                     isalnum.c \
                     isalpha.c \
                     isdigit.c \
                     isprint.c \
                     isxdigit.c \
                     isspace.c \
                     tolower.c \
                     \
                     printf.c \
                     snprintf.c \
                     sprintf.c \
                     vfprintf.c \
                     vsnprintf.c \
                     vsprintf.c \
                     vprintf.c \
                     puts.c \
                     \
                     atexit.c \
                     \
                     intscan.c

CXXSRC_LIBC += strstr.cc

# riscv32: needed by intscan.c
VPATH             += lib/libk/quad
CSRC_LIBC         += lshrdi3.c
ASSRC_LIBC        := setjmp.S longjmp.S \
                     $(if $(filter ia32,$(CONFIG_XARCH)),memcpy-i386.S)
NOBUILTIN         += $(patsubst %.o, %, $(OBJ_LIBC))

#
# LIBFDT subsystem
#
ifeq ($(CONFIG_DT),y)
  LIBFDT              := libfdt.a
  SUBSYSTEMS          += LIBFDT
  KERNEL_EXTRA_LIBS   += $(LIBFDT)
  VPATH               += lib/libfdt
  PRIVATE_INCDIR      += lib/libfdt
  CSRC_LIBFDT         := fdt.c fdt_ro.c fdt_strerror.c fdt_addresses.c
  # WARNING EXCEPTION: suppress warnings about bad function casts in unmodified
  # upstream code.
  $(foreach f, $(patsubst %.c, %, $(CSRC_LIBFDT)), \
          $(eval CFLAGS_$(f) += -Wno-bad-function-cast))
endif
